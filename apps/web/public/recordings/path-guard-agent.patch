@@ -1,5 +1,16 @@
-import { resolve } from 'node:path';
+import { resolve, relative, isAbsolute, sep } from 'node:path';
 
 export function isWithin(root: string, target: string): boolean {
-  return resolve(target).startsWith(resolve(root));
+  const resolvedRoot = resolve(root);
+  const resolvedTarget = resolve(target);
+  const rel = relative(resolvedRoot, resolvedTarget);
+
+  // The root itself is within the root.
+  if (rel === '') return true;
+
+  // A path resolving to a sibling/ancestor (or outside on another root) is not
+  // a descendant: relative() yields '..', '../x', or an absolute path.
+  if (rel === '..' || rel.startsWith('..' + sep)) return false;
+
+  return !isAbsolute(rel);
 }
